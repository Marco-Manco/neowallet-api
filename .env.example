# ==========================================
# NeoWallet API - Environment Configuration
# ==========================================

# Server Configuration
# --------------------
PORT=3000

# Database Configuration (PostgreSQL)
# -----------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_NAME=neowallet_db

# JWT Configuration
# -----------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h

# Seed Data (Admin User)
# ----------------------
ADMIN_SEED_EMAIL=admin@neowallet.com
ADMIN_SEED_PASSWORD=your-secure-admin-password

# External API Providers
# ----------------------
# DolarAPI for ARS/USD exchange rates
DOLAR_API_URL=https://dolarapi.com/v1/dolares

# Binance API for crypto exchange rates
BINANCE_API_URL=https://api.binance.com/api/v3/ticker/price

# Redis Configuration (for caching and BullMQ)
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ Board (Queue Monitoring)
# -------------------------------
BULLMQ_BOARD_PORT=3001
